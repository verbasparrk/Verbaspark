VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
# Optional: enables automatic Google Maps embeds from the address.
# Restrict this browser key to Maps Embed API and your website domains.
VITE_GOOGLE_MAPS_EMBED_KEY=

# Server-only. Never add a VITE_ prefix or commit real values.
# Required for contact submissions, analytics, and server-rendered link previews.
SUPABASE_SERVICE_ROLE_KEY=
ANALYTICS_HASH_SECRET=
APP_URL=http://127.0.0.1:5173
